vendor/

# a commercial ROM to test against, which is not ours to carry
_realRomTest/
_romFromHaxe/

# generated ROM sources and build output, all reproducible from build.sh
tests/roms/*/rom/out/
tests/roms/*/rom/res/*
tests/roms/*/rom/src/*
!tests/roms/*/rom/src/testio.c
!tests/roms/*/rom/src/testio.h
!tests/roms/*/rom/src/native.c
!tests/roms/*/rom/src/native.h

emulator/bin/
tests/harness/.build/
tests/.build.log
tests/.observables.txt
tests/.template/
tests/.linked.txt
tests/.libmd.txt
tests/.run-copy.sh

*.o
*.bin
*.out

# the window type check, which writes nothing it keeps
tests/.hostcheck/

# where the pad comparison puts the two ROMs it holds to each other
tests/.pad/

# the settings files the settings check writes and reads again
tests/.settings/
tests/opn2/.build/

# the gdb session the remote protocol check drives, and what the stub said while it ran
tests/.gdb/

# the resource pipeline check, built on demand
sdk/bin/
tests/.resources/

# permission entries this tooling writes for itself
.claude/settings.json
