-cp src
-main hx68k.host.Workbench
-cpp bin/window

# the same three the window is built with, so what a check measures against it stays honest
-D analyzer-optimize
-D HXCPP_OPTIMIZE_LINK
-D HXCPP_GC_GENERATIONAL

# SDL3PATH and NATIVEPATH are handed in by build.sh, since a plain .hxml cannot see the
# repository's own absolute path and hxcpp's build.xml wants one to find SDL3 and emulator/native
