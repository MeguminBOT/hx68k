# every program the gate runs, in one binary, chosen by its first argument:
#   ./gate.sh <program> [arguments]
-cp src
-main hx68k.test.Gate
-cpp ../export/md/tests/obj/gate

# the same three the window is built with, so a check measures the build that ships
-D analyzer-optimize
-D HXCPP_OPTIMIZE_LINK
-D HXCPP_GC_GENERATIONAL
