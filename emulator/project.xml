<?xml version="1.0" encoding="utf-8"?>
<project>
	<meta title="hx68k" package="dev.hx68k.window" version="0.1.0" company="hx68k" />
	<app main="hx68k.host.Console" file="hx68k" path="bin/window" />

	<source path="src" />
	<haxelib name="lime" />

	<!--
		Vsync paces the update loop off the monitor rather than off a Windows timer, whose tick is
		fifteen milliseconds unless something has asked otherwise. That evenness is worth more to the
		sound than the rate itself is: the machine is paced by its own clock in Console either way,
		and what a steady update buys is a device buffer half the size.
	-->
	<window width="960" height="672" fps="60" background="#000000" resizable="true"
		hardware="true" vsync="true" allow-high-dpi="true" />

	<!-- openfl and everything above it are deliberately absent: this needs a window and a texture -->
	<haxeflag name="-dce" value="full" />
	<haxeflag name="--no-traces"/>

	<!--
		Measured with emulator/speed.hxml, which carries the same three, on 200 frames of a game:
		2.05 milliseconds a frame plain, 1.93 with the analyzer, 1.83 with whole program optimisation.

		analyzer-optimize is Haxe's own pass over what it emits, before hxcpp sees any of it.

		HXCPP_OPTIMIZE_LINK is -GL and -LTCG on MSVC, which lets the compiler inline across the files
		it emits. That is worth having here rather than anywhere else, because a slot of the FM chip
		crosses four of them and a bus cycle of the machine crosses five. It costs a slow link.

		HXCPP_GC_GENERATIONAL changes nothing that a throughput measurement can see, and is here for
		the length of a collection rather than the number of them: a pause of a frame is heard.
	-->
	<haxedef name="analyzer-optimize" />
	<haxedef name="HXCPP_OPTIMIZE_LINK" />
	<haxedef name="HXCPP_GC_GENERATIONAL" />
</project>
