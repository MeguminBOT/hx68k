package hx68k.host.ui;

class Glyphs {
	public static inline final FIRST = 32;
	public static inline final LAST = 126;
	public static inline final WIDTH = 8;
	public static inline final HEIGHT = 16;

	static var rows:haxe.io.Bytes;

	public static function of(code:Int):haxe.io.Bytes {
		if (rows == null) rows = haxe.crypto.Base64.decode(PACKED);
		final at = (code - FIRST) * HEIGHT;
		return rows.sub(at, HEIGHT);
	}

	static inline final PACKED = "";
}
