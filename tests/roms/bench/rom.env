# the one ROM here that links SGDK as well as md.*, to measure one against the other
GDK_POSIX="$(cd ../../../vendor/SGDK && pwd)"
GDK="$(cygpath -m "$GDK_POSIX" 2>/dev/null || echo "$GDK_POSIX")"

export EXTRA_FLAGS="-DSGDK_GCC -isystem $GDK/inc -isystem $GDK/out/release"
export EXTRA_LIBS="$GDK_POSIX/lib/libmd.a"
export MD_BOOT="$GDK_POSIX/src/boot/sega.s"

# native.c is this ROM's own probe shim, so the shared one is left out
export MD_CSRC="c"

# SGDK's own boot file incbins the header from out/, not from obj/
export MD_HEADER_AT="out/rom_header.bin"
